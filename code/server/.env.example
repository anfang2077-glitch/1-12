# =============================================================================
# 后端环境变量示例：复制为 .env 后按需修改
# 无 MySQL 时把 MYSQL_DRIVER 改为 memory，或直接 npm run start:memory
# =============================================================================
PORT=3000
NODE_ENV=development
BODY_LIMIT=1mb

# JWT 密钥（生产环境务必替换为随机长字符串）与有效期（基线固定 8h）
JWT_SECRET=exam-system-dev-secret-change-me
JWT_EXPIRES_IN=8h

# 数据访问驱动：mysql | memory
MYSQL_DRIVER=mysql

# MySQL 连接配置
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=exam_system
MYSQL_CONNECTION_LIMIT=10
MYSQL_TIMEZONE=+08:00
